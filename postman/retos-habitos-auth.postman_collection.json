{
  "info": {
    "_postman_id": "1f5fd443-5ed5-44f4-b12c-962acbafa07d",
    "name": "Retos de hábitos — Autenticación (parte A)",
    "description": "Pruebas de registro, login y protección de rutas.\n\n1. Levanta la API (`npm run dev`).\n2. Revisa la variable `baseUrl`.\n3. Corre toda la colección en orden con el Runner.\n\nLos tokens se guardan solos en las variables `adminToken` y `userToken`. Las credenciales son las del seed (datos de prueba, no reales).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Salud",
      "item": [
        {
          "name": "GET /health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"La base responde\", () => pm.expect(pm.response.json().database).to.eql(\"ok\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "Registro",
      "item": [
        {
          "name": "Registro nuevo → 201",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Email distinto en cada corrida para que la colección se pueda repetir",
                  "pm.collectionVariables.set(\"nuevoEmail\", `postman.${Date.now()}@retos.app`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "const respuesta = pm.response.json().data;",
                  "pm.test(\"Devuelve usuario y token\", () => {",
                  "  pm.expect(respuesta.user.email).to.eql(pm.collectionVariables.get(\"nuevoEmail\"));",
                  "  pm.expect(respuesta.token.accessToken).to.be.a(\"string\");",
                  "  pm.expect(respuesta.token.expiresIn).to.be.above(0);",
                  "});",
                  "pm.test(\"Ignora el rol del body: siempre crea user\", () => pm.expect(respuesta.user.rol).to.eql(\"user\"));",
                  "pm.test(\"No incluye contraseña ni hash\", () => {",
                  "  const text = pm.response.text();",
                  "  pm.expect(text).to.not.include(\"password\");",
                  "  pm.expect(text).to.not.include(\"passwordHash\");",
                  "  pm.expect(text).to.not.match(/\\$2[aby]\\$/);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuaria Postman\",\n  \"email\": \"{{nuevoEmail}}\",\n  \"password\": \"Clave2026x\",\n  \"rol\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Mismo email otra vez → 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"Responde 409\", () => pm.response.to.have.status(409));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Repetida\",\n  \"email\": \"{{nuevoEmail}}\",\n  \"password\": \"Clave2026x\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Datos inválidos → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Trae un mensaje por campo\", () => pm.expect(pm.response.json().details).to.have.all.keys(\"nombre\", \"email\", \"password\"));",
                  "pm.test(\"No expone el stack trace\", () => pm.expect(pm.response.text()).to.not.include(\"    at \"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"A\",\n  \"email\": \"no-es-email\",\n  \"password\": \"corta\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Login",
      "item": [
        {
          "name": "Login admin del seed → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const respuesta = pm.response.json().data;",
                  "pm.test(\"Es admin\", () => pm.expect(respuesta.user.rol).to.eql(\"admin\"));",
                  "pm.collectionVariables.set(\"adminToken\", respuesta.token.accessToken);",
                  "pm.test(\"No incluye contraseña ni hash\", () => {",
                  "  const text = pm.response.text();",
                  "  pm.expect(text).to.not.include(\"password\");",
                  "  pm.expect(text).to.not.include(\"passwordHash\");",
                  "  pm.expect(text).to.not.match(/\\$2[aby]\\$/);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
