                  "pm.collectionVariables.set(\"userToken\", pm.response.json().data.token.accessToken);",
                  "pm.test(\"No incluye contraseña ni hash\", () => {",
                  "  const text = pm.response.text();",
                  "  pm.expect(text).to.not.include(\"password\");",
                  "  pm.expect(text).to.not.include(\"passwordHash\");",
                  "  pm.expect(text).to.not.match(/\\$2[aby]\\$/);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
